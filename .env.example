# WonderBook Live — Environment Configuration Template
# Copy this file to `.env` and fill in your credentials.
# NEVER commit `.env` or real API keys to version control.

# 1. Google AI / Gemini API Key (Required for live multimodal inference)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Multi-Agent Model Selection (Optional overrides)
PRIMARY_MODEL=gemini-4-argon
FAST_STORY_MODEL=gemini-3.8-flash
FALLBACK_MODEL=gemini-3.8-flash
NANO_BANANA_PRO_MODEL=gemini-3-pro-image-preview
NANO_BANANA_MODEL=gemini-2.5-flash-image
VEO_MODEL=veo-3.1-fast-generate-preview
WONDERBOOK_TTS_MODEL=gemini-2.5-flash-preview-tts
WONDERBOOK_TTS_PRO_MODEL=gemini-2.5-pro-preview-tts
THINKING_LEVEL=low

# 3. Google Cloud Run & Cloud Storage (Optional for cloud publishing)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
ARTIFACT_BUCKET=your-private-gcs-bucket-name
RUN_REGION=us-central1
STORAGE_REGION=us-central1
TRANSCODER_REGION=us-central1
RUN_SERVICE=wonderbook-live
RUN_SERVICE_ACCOUNT=wonderbook-runner@your-gcp-project-id.iam.gserviceaccount.com

# 4. Local Server Port
PORT=8080
